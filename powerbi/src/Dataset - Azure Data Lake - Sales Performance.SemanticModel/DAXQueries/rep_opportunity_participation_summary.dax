// rep_opportunity_participation_summary
// Canonical logic is materialized at model refresh in the semantic-model table
// of the same name so saved-query consumers and report visuals stay in parity.

EVALUATE
    SELECTCOLUMNS (
        'rep_opportunity_participation_summary',
        "Rep Name", 'rep_opportunity_participation_summary'[Rep Name],
        "Rep ID", 'rep_opportunity_participation_summary'[Rep ID],
        "Team", 'rep_opportunity_participation_summary'[Team],
        "Manager", 'rep_opportunity_participation_summary'[Manager],
        "Claimed Opportunity Count", 'rep_opportunity_participation_summary'[Claimed Opportunity Count],
        "Confirmed Opportunity Count", 'rep_opportunity_participation_summary'[Confirmed Opportunity Count],
        "Light Participation Count", 'rep_opportunity_participation_summary'[Light Participation Count],
        "Claimed - No Evidence Count", 'rep_opportunity_participation_summary'[Claimed - No Evidence Count],
        "Inactive Contributor Count", 'rep_opportunity_participation_summary'[Inactive Contributor Count],
        "Unclaimed Contribution Count", 'rep_opportunity_participation_summary'[Unclaimed Contribution Count],
        "Insufficient Data Count", 'rep_opportunity_participation_summary'[Insufficient Data Count],
        "Confirmed Participation Rate", 'rep_opportunity_participation_summary'[Confirmed Participation Rate],
        "Claimed Pipeline Amount", 'rep_opportunity_participation_summary'[Claimed Pipeline Amount],
        "Confirmed Pipeline Amount", 'rep_opportunity_participation_summary'[Confirmed Pipeline Amount],
        "Unsupported Claimed Pipeline", 'rep_opportunity_participation_summary'[Unsupported Claimed Pipeline],
        "Average Participation Score", 'rep_opportunity_participation_summary'[Average Participation Score],
        "Overall Participation Status", 'rep_opportunity_participation_summary'[Overall Participation Status]
    )

ORDER BY
    [Overall Participation Status] ASC,
    [Confirmed Participation Rate] ASC,
    [Rep Name] ASC
