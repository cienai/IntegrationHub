	measure 'meas.opp_success_profile_share_successful_new_logo' = ```

			var successful_count = opportunity_success_profile_characteristics[meas.opp_success_profile_successful_new_logo_count]
			var total_successful =
			    CALCULATE(
			        ssr_history[meas.ssr_history_success_count_new_logo],
			        REMOVEFILTERS(opportunity_success_profile_characteristics)
			    )
			var res = DIVIDE(successful_count, total_successful, BLANK())
			return res

			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _opportunity_success_profile
		lineageTag: c067dd42-b80d-4434-8a4a-f8558ca6f715

	measure 'meas.opp_success_profile_share_all_new_logo' = ```

			var all_count = opportunity_success_profile_characteristics[meas.opp_success_profile_all_new_logo_count]
			var total_all =
			    CALCULATE(
			        ssr_history[meas.ssr_history_step_count],
			        ssr_history[step_name] = "New Logo Selling",
			        REMOVEFILTERS(opportunity_success_profile_characteristics)
			    )
			var res = DIVIDE(all_count, total_all, BLANK())
			return res

