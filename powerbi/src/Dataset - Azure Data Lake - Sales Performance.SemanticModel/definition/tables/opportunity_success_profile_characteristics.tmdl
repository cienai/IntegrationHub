	partition opportunity_success_profile_characteristics = calculated
		mode: import
		source = ```

				VAR IndustryRows =
				    SELECTCOLUMNS(
				        FILTER(
				            SUMMARIZE(ssr, ssr[trueai_industry]),
				            NOT ISBLANK(ssr[trueai_industry])
				                && ssr[trueai_industry] <> "ND"
				        ),
				        "Dimension", "Industry",
				        "Characteristic", ssr[trueai_industry],
				        "Dimension Sort", 1,
				        "Characteristic Sort", 0
				    )
				VAR CompanySizeRows =
				    SELECTCOLUMNS(
				        FILTER(
				            SUMMARIZE(
				                ssr,
				                ssr[trueai_custom_company_size],
				                "__sort", AVERAGE(ssr[col.trueai_company_size_aprox_val])
				            ),
				            NOT ISBLANK(ssr[trueai_custom_company_size])
				                && ssr[trueai_custom_company_size] <> "ND"
				        ),
				        "Dimension", "Company Size",
				        "Characteristic", ssr[trueai_custom_company_size],
				        "Dimension Sort", 2,
				        "Characteristic Sort", [__sort]
				    )
				RETURN
				    UNION(IndustryRows, CompanySizeRows)

				```

	annotation PBI_Id = 2d46ef9490964705b3a59c1d9b72279a
