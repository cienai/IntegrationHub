	measure 'meas.opp_success_profile_new_logo_difference_pp' = ```

			var successful_share = opportunity_success_profile_characteristics[meas.opp_success_profile_share_successful_new_logo]
			var all_share = opportunity_success_profile_characteristics[meas.opp_success_profile_share_all_new_logo]
			var res = successful_share - all_share
			return res

			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: _opportunity_success_profile
		lineageTag: 522cb150-1292-415a-bfef-f04b0ab734ec

	measure 'meas.opp_success_profile_new_logo_success_index' = ```

			var successful_share = opportunity_success_profile_characteristics[meas.opp_success_profile_share_successful_new_logo]
			var all_share = opportunity_success_profile_characteristics[meas.opp_success_profile_share_all_new_logo]
			var res = DIVIDE(successful_share, all_share, BLANK())
			return res

