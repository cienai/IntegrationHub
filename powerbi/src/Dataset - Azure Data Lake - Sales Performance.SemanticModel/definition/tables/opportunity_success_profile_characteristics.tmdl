	measure 'meas.opp_success_profile_top_overrepresented_characteristic' = ```

			var profile_rows =
			    FILTER(
			        ALLSELECTED(opportunity_success_profile_characteristics),
			        opportunity_success_profile_characteristics[meas.opp_success_profile_include_row] = 1
			            && opportunity_success_profile_characteristics[meas.opp_success_profile_new_logo_difference_pp] > 0
			    )
			var top_row =
			    TOPN(
			        1,
			        profile_rows,
			        opportunity_success_profile_characteristics[meas.opp_success_profile_new_logo_difference_pp],
			        DESC,
			        opportunity_success_profile_characteristics[meas.opp_success_profile_successful_new_logo_count],
			        DESC,
			        opportunity_success_profile_characteristics[Characteristic],
			        ASC
			    )
			var res =
			    CONCATENATEX(
			        top_row,
			        opportunity_success_profile_characteristics[Dimension] & ": " & opportunity_success_profile_characteristics[Characteristic]
			    )
			return res

			```
		displayFolder: _opportunity_success_profile
		lineageTag: e9530168-8105-4428-a8d4-86085d56bd81

	measure 'meas.opp_success_profile_top_overrepresented_detail' = ```

			var profile_rows =
			    FILTER(
			        ALLSELECTED(opportunity_success_profile_characteristics),
			        opportunity_success_profile_characteristics[meas.opp_success_profile_include_row] = 1
			            && opportunity_success_profile_characteristics[meas.opp_success_profile_new_logo_difference_pp] > 0
			    )
			var top_row =
			    TOPN(
			        1,
			        profile_rows,
			        opportunity_success_profile_characteristics[meas.opp_success_profile_new_logo_difference_pp],
			        DESC,
			        opportunity_success_profile_characteristics[meas.opp_success_profile_successful_new_logo_count],
			        DESC,
			        opportunity_success_profile_characteristics[Characteristic],
			        ASC
			    )
			var res =
			    CONCATENATEX(
			        top_row,
			        FORMAT(opportunity_success_profile_characteristics[meas.opp_success_profile_new_logo_difference_pp], "+0.0%;-0.0%;0.0%")
			            & " diff vs. all New Logo"
			    )
			return res

			```
		displayFolder: _opportunity_success_profile
		lineageTag: 8c27f925-5f22-47af-805e-cd38e145d7fb

