	measure 'meas.opp_success_profile_direction' = ```

			var difference = opportunity_success_profile_characteristics[meas.opp_success_profile_new_logo_difference_pp]
			var res =
			    SWITCH(
			        TRUE(),
			        difference > 0, "Overrepresented",
			        difference < 0, "Underrepresented",
			        "Neutral"
			    )
			return res

			```
		displayFolder: _opportunity_success_profile
		lineageTag: e5ac2014-4b75-46e3-9ad7-c34936d933f8

	measure 'meas.opp_success_profile_business_impact' = ```

			var successful_count = opportunity_success_profile_characteristics[meas.opp_success_profile_successful_new_logo_count]
			var res =
			    SWITCH(
			        TRUE(),
			        successful_count >= 1000, "High",
			        successful_count >= 250, "Medium",
			        NOT ISBLANK(successful_count), "Low"
			    )
			return res

			```
		displayFolder: _opportunity_success_profile
		lineageTag: 1314697b-3dc7-4f55-972e-e7f4e58d4191

	measure 'meas.opp_success_profile_business_impact_sort' = ```

			var successful_count = opportunity_success_profile_characteristics[meas.opp_success_profile_successful_new_logo_count]
			var res =
			    SWITCH(
			        TRUE(),
			        successful_count >= 1000, 1,
			        successful_count >= 250, 2,
			        NOT ISBLANK(successful_count), 3
			    )
			return res

			```
		formatString: 0
		displayFolder: _opportunity_success_profile
		lineageTag: 5344595f-ca05-4bbf-9a8a-bb5d769f82b6

	measure 'meas.opp_success_profile_include_row' = ```

			var successful_count = opportunity_success_profile_characteristics[meas.opp_success_profile_successful_new_logo_count]
			var all_count = opportunity_success_profile_characteristics[meas.opp_success_profile_all_new_logo_count]
			var difference = opportunity_success_profile_characteristics[meas.opp_success_profile_new_logo_difference_pp]
			var res =
			    IF(
			        successful_count >= 25
			            && all_count >= 100
			            && ABS(difference) >= 0.02,
			        1,
			        0
			    )
			return res

			```
		formatString: 0
		displayFolder: _opportunity_success_profile
		lineageTag: 649f9112-deab-4e31-a857-75650cf93f64

