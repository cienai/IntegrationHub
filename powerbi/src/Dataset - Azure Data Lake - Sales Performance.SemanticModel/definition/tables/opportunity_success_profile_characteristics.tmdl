table opportunity_success_profile_characteristics
	lineageTag: 5575fd69-a8eb-4b1d-ab7c-ed1109af1179

	measure 'meas.opp_success_profile_successful_new_logo_count' = ```

			var selected_dimension = SELECTEDVALUE(opportunity_success_profile_characteristics[Dimension])
			var selected_characteristic = SELECTEDVALUE(opportunity_success_profile_characteristics[Characteristic])
			var res =
			    SWITCH(
			        TRUE(),
			        selected_dimension = "Industry",
			            CALCULATE(
			                ssr_history[meas.ssr_history_success_count_new_logo],
			                KEEPFILTERS(TREATAS({selected_characteristic}, ssr[trueai_industry]))
			            ),
			        selected_dimension = "Company Size",
			            CALCULATE(
			                ssr_history[meas.ssr_history_success_count_new_logo],
			                KEEPFILTERS(TREATAS({selected_characteristic}, ssr[trueai_custom_company_size]))
			            )
			    )
			return res

			```
		formatString: #,0
		displayFolder: _opportunity_success_profile
		lineageTag: 7406cf3a-0992-4315-8e23-f4ced61ad910

	measure 'meas.opp_success_profile_all_new_logo_count' = ```

			var selected_dimension = SELECTEDVALUE(opportunity_success_profile_characteristics[Dimension])
			var selected_characteristic = SELECTEDVALUE(opportunity_success_profile_characteristics[Characteristic])
			var res =
			    SWITCH(
			        TRUE(),
			        selected_dimension = "Industry",
			            CALCULATE(
			                ssr_history[meas.ssr_history_step_count],
			                ssr_history[step_name] = "New Logo Selling",
			                KEEPFILTERS(TREATAS({selected_characteristic}, ssr[trueai_industry]))
			            ),
			        selected_dimension = "Company Size",
			            CALCULATE(
			                ssr_history[meas.ssr_history_step_count],
			                ssr_history[step_name] = "New Logo Selling",
			                KEEPFILTERS(TREATAS({selected_characteristic}, ssr[trueai_custom_company_size]))
			            )
			    )
			return res

			```
