	partition rep_opportunity_overlap_participation_buckets = calculated
		mode: import
		source = ```

				DATATABLE(
				    "Bucket", STRING,
				    "Bucket Sort", INTEGER,
				    "Bucket Min", DOUBLE,
				    "Bucket Max", DOUBLE,
				    {
				        {"95-100%", 1, 0.95, 1.0000001},
				        {"90-95%", 2, 0.90, 0.95},
				        {"80-90%", 3, 0.80, 0.90},
				        {"70-80%", 4, 0.70, 0.80},
				        {"<70%", 5, 0.00, 0.70}
				    }
				)

