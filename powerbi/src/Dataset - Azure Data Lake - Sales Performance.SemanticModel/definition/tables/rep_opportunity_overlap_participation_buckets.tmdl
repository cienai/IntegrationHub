table rep_opportunity_overlap_participation_buckets
	lineageTag: faea2312-02bd-4152-b568-5a7dc462a97a

	/// Number of eligible Account Executives whose participation percentage falls in the selected bucket.
	measure 'meas.rep_opp_overlap_bucket_rep_count' = ```

			var bucket_min = SELECTEDVALUE(rep_opportunity_overlap_participation_buckets[Bucket Min])
			var bucket_max = SELECTEDVALUE(rep_opportunity_overlap_participation_buckets[Bucket Max])
			var eligible_reps =
			    FILTER(
			        ALLSELECTED(rep_opportunity_overlap),
			        rep_opportunity_overlap[meas.rep_opp_overlap_include_row] = 1
			            && rep_opportunity_overlap[meas.rep_opp_overlap_participation_pct] >= bucket_min
			            && rep_opportunity_overlap[meas.rep_opp_overlap_participation_pct] < bucket_max
			    )
			var res = COUNTROWS(eligible_reps)
			return res

			```
		formatString: #,0
		displayFolder: _rep_opportunity_overlap
		lineageTag: 30b121b1-4803-4cbf-8ae7-73d19fe72cd8

