	partition rep_opportunity_overlap = calculated
		mode: import
		source = ```
				
				SELECTCOLUMNS(
				    FILTER(
				        SUMMARIZE(
				            users,
				            users[_sys_doc_id],
				            users[trueai_full_name],
				            users[trueai_group],
				            users[col.rep_details_rep_manager_name],
				            users[trueai_user_role]
				        ),
				        users[trueai_user_role] = "Account Executive"
				            && NOT ISBLANK(users[_sys_doc_id])
				            && NOT ISBLANK(users[trueai_full_name])
				    ),
				    "User Id", users[_sys_doc_id],
				    "Representative", users[trueai_full_name],
				    "Team", COALESCE(users[trueai_group], "Unassigned"),
				    "Manager", COALESCE(users[col.rep_details_rep_manager_name], "Unassigned"),
				    "Representative Sort", users[trueai_full_name]
				)
				
				```

	annotation PBI_Id = c27eb0bb24ed474b87401ac075a3d8a1

