table Comparison
	lineageTag: 40e6fd54-8d93-47fd-b764-8d3aa2889cad

	calculationGroup
		precedence: 22

		calculationItem Selected =
				VAR SelectedUser =
				    SELECTEDVALUE ( users[trueai_full_name] )
				
				RETURN
				IF (
				    NOT ISBLANK ( SelectedUser ),
				    CALCULATE (
				        SELECTEDMEASURE (),
				        KEEPFILTERS ( users[trueai_full_name] = SelectedUser )
				    )
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Peer Avg' =
				VAR SelectedUser =
				    SELECTEDVALUE ( users[trueai_full_name] )
				
				VAR SelectedRole =
				    SELECTEDVALUE ( users[trueai_user_role_alias] )
				
				VAR SelectedGroup =
				    SELECTEDVALUE ( users[trueai_group] )
				
				RETURN
				IF (
				    NOT ISBLANK ( SelectedUser ),
				    AVERAGEX (
				        FILTER (
				            ALL ( users ),
				            users[trueai_user_role_alias] = SelectedRole
				                && users[trueai_group] = SelectedGroup
				        ),
				        CALCULATE ( SELECTEDMEASURE () )
				    ),
				    BLANK ()
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem Delta =
				VAR SelectedUser =
				    SELECTEDVALUE ( users[trueai_full_name] )
				
				VAR SelectedRole =
				    SELECTEDVALUE ( users[trueai_user_role_alias] )
				
				VAR SelectedGroup =
				    SELECTEDVALUE ( users[trueai_group] )
				
				VAR UserValue =
				    SELECTEDMEASURE ()
				
				VAR PeerAvg =
				    AVERAGEX (
				        FILTER (
				            ALL ( users ),
				            users[trueai_user_role_alias] = SelectedRole
				                && users[trueai_group] = SelectedGroup
				        ),
				        CALCULATE ( SELECTEDMEASURE () )
				    )
				
				RETURN
				IF (
				    NOT ISBLANK ( SelectedUser ),
				    UserValue - PeerAvg,
				    BLANK ()
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem '% vs Peers' =
				VAR SelectedUser =
				    SELECTEDVALUE ( users[trueai_full_name] )
				
				VAR SelectedRole =
				    SELECTEDVALUE ( users[trueai_user_role_alias] )
				
				VAR SelectedGroup =
				    SELECTEDVALUE ( users[trueai_group] )
				
				VAR UserValue =
				    SELECTEDMEASURE ()
				
				VAR PeerAvg =
				    AVERAGEX (
				        FILTER (
				            ALL ( users ),
				            users[trueai_user_role_alias] = SelectedRole
				                && users[trueai_group] = SelectedGroup
				        ),
				        CALCULATE ( SELECTEDMEASURE () )
				    )
				
				RETURN
				IF (
				    NOT ISBLANK ( SelectedUser ),
				    DIVIDE ( UserValue, PeerAvg ),
				    BLANK ()
				)

			formatStringDefinition = "0.0%"

