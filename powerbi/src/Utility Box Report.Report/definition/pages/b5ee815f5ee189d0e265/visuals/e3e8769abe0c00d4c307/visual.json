            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"description\": \"5-bar visual using ci_sb_work_effort_num with blank handling\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"transform\": [\n    {\n      \"aggregate\": [\n        {\n          \"op\": \"mean\",\n          \"field\": \"ci_sb_work_effort_num\",\n          \"as\": \"score\"\n        }\n      ]\n    },\n    {\n      \"calculate\": \"[1, 2, 3, 4, 5]\",\n      \"as\": \"bars\"\n    },\n    {\n      \"flatten\": [\"bars\"]\n    },\n    {\n      \"calculate\": \"datum.bars\",\n      \"as\": \"bar\"\n    },\n\n    {\n      \"calculate\": \"datum.score == null ? 0 : (datum.score <= 0.2 ? 1 : datum.score <= 0.4 ? 2 : datum.score <= 0.6 ? 3 : datum.score <= 0.8 ? 4 : 5)\",\n      \"as\": \"barsToFill\"\n    },\n\n    {\n      \"calculate\": \"datum.bar <= datum.barsToFill\",\n      \"as\": \"isFilled\"\n    },\n\n    {\n      \"calculate\": \"datum.isFilled ? (datum.barsToFill == 1 ? ''#CF4C83'' : datum.barsToFill == 2 ? ''#FF7F00'' : datum.barsToFill == 3 ? ''#99CC66'' : datum.barsToFill == 4 ? ''#71A43D'' : ''#336600'') : ''#E0E0E0''\",\n      \"as\": \"barColor\"\n    }\n  ],\n\n  \"mark\": {\n    \"type\": \"bar\",\n    \"cornerRadius\": 10,\n    \"cornerRadiusEnd\": 10\n  },\n\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"bar\",\n      \"type\": \"ordinal\",\n      \"axis\": null,\n      \"scale\": {\n        \"paddingInner\": 0.5\n      }\n    },\n    \"y\": {\n      \"value\": 1\n    },\n    \"color\": {\n      \"field\": \"barColor\",\n      \"type\": \"nominal\",\n      \"scale\": null\n    },\n    \"tooltip\": [\n      {\n        \"field\": \"score\",\n        \"type\": \"quantitative\",\n        \"title\": \"Score\",\n        \"format\": \".0%\"\n      }\n    ]\n  },\n\n  \"config\": {\n    \"view\": {\n      \"stroke\": \"transparent\"\n    },\n    \"axis\": {\n      \"domain\": false,\n      \"ticks\": false\n    }\n  }\n}'"
