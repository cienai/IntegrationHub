		lineageTag: 2a2aaae7-6fbb-4e6d-bf1f-622ec42af995

	/// Average number of distinct reps with governed step-owner activity evidence per credited opportunity.
	measure 'meas.rep_opp_overlap_avg_meaningfully_involved_reps_per_opp' = ```
			
			var selected_opportunities =
			    CALCULATETABLE(
			        VALUES(opps[_sys_doc_id]),
			        TREATAS(VALUES(rep_opportunity_overlap[User Id]), opps[trueai_owner_id])
			    )
			var res =
			    AVERAGEX(
			        selected_opportunities,
			        var current_opp_id = opps[_sys_doc_id]
			        return
			            CALCULATE(
			                DISTINCTCOUNT(ssr_history[step_owner_id]),
			                ssr_history[col.sales_steps_opp_id] = current_opp_id,
			                FILTER(
			                    ssr_history,
			                    ssr_history[step_name] IN {"New Logo Selling", "Existing Customer Selling"}
			                        && (
			                            COALESCE(ssr_history[step_owner_act], 0) > 0
			                                || COALESCE(ssr_history[step_owner_dur], 0) > 0
			                        )
			                )
			            )
			    )
			return res
			
			```
		formatString: 0.00
		displayFolder: _rep_opportunity_overlap
		lineageTag: a1f636b4-7a42-47f7-a6c7-7b421fcf3a55

