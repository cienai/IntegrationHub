			        SUMMARIZE(
			            ALLSELECTED(rep_opportunity_overlap),
			            rep_opportunity_overlap[Team],
			            "__mismatches", rep_opportunity_overlap[meas.rep_opp_overlap_potential_credit_mismatch_count]
			        ),
			        [__mismatches] > 0
