	/// User-facing header insight for the page.
	measure 'Rep Opportunity Overlap executive insight' = ```
			
			var involvement_pct = rep_opportunity_overlap[meas.rep_opp_overlap_overall_avg_participation_pct]
			var review_pct = 1 - involvement_pct
