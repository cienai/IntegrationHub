/// Participation integrity review for credited Account Executive opportunities.
/// Credited opportunity: opps row where opps[trueai_owner_id] is the Account Executive.
/// Meaningful participation evidence: same AE owns a selling step for the opportunity and has step_owner_act > 0 or step_owner_dur > 0.
/// Potential credit mismatch: credited opportunity without that governed step-owner activity evidence.
table rep_opportunity_overlap
	lineageTag: f8885629-f067-4ee4-912f-3ca89f8ab3e0

	/// Count of credited opportunities for the selected Account Executive population. A credited opportunity is an opportunity owned by the AE in opps[trueai_owner_id].
	measure 'meas.rep_opp_overlap_assigned_opportunities' = ```
			
			var selected_rep_ids = VALUES(rep_opportunity_overlap[User Id])
			var res =
			    CALCULATE(
			        DISTINCTCOUNT(opps[_sys_doc_id]),
			        TREATAS(selected_rep_ids, opps[trueai_owner_id])
			    )
			return res
			
			```
		formatString: #,0
		displayFolder: _rep_opportunity_overlap
		lineageTag: 1dbd0b64-dcfd-4ecd-8dba-73e5fcb387fe

	/// Count of credited opportunities where the credited AE has governed step-owner activity evidence on a selling step for the same opportunity.
	measure 'meas.rep_opp_overlap_participated_opportunities' = ```
			
			var selected_rep_ids = VALUES(rep_opportunity_overlap[User Id])
			var credited_opportunities =
			    CALCULATETABLE(
			        VALUES(opps[_sys_doc_id]),
			        TREATAS(selected_rep_ids, opps[trueai_owner_id])
			    )
			var evidenced_opportunities =
			    CALCULATETABLE(
			        FILTER(
			            VALUES(ssr_history[col.sales_steps_opp_id]),
			            NOT ISBLANK(ssr_history[col.sales_steps_opp_id])
			        ),
			        TREATAS(selected_rep_ids, ssr_history[step_owner_id]),
			        TREATAS(credited_opportunities, ssr_history[col.sales_steps_opp_id]),
			        FILTER(
			            ssr_history,
			            ssr_history[step_name] IN {"New Logo Selling", "Existing Customer Selling"}
			                && (
			                    COALESCE(ssr_history[step_owner_act], 0) > 0
			                        || COALESCE(ssr_history[step_owner_dur], 0) > 0
			                )
			        )
			    )
			var res = COUNTROWS(evidenced_opportunities)
			return res
			
			```
		formatString: #,0
		displayFolder: _rep_opportunity_overlap
		lineageTag: e8d3b56e-6115-4d6a-bfac-1ca5c2b0a309

	/// Share of credited opportunities with governed step-owner activity evidence for the credited AE.
	measure 'meas.rep_opp_overlap_participation_pct' = ```
			
			var res =
			    DIVIDE(
			        rep_opportunity_overlap[meas.rep_opp_overlap_participated_opportunities],
			        rep_opportunity_overlap[meas.rep_opp_overlap_assigned_opportunities],
			        BLANK()
			    )
			return res
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _rep_opportunity_overlap
		lineageTag: c3a7a8fb-43a8-4f70-8e3a-7b59f2d2ba1d

	/// Overall participation integrity across credited AE-opportunity relationships in the selected context.
	measure 'meas.rep_opp_overlap_overall_avg_participation_pct' = ```
			
			var eligible_reps =
			    FILTER(
			        ALLSELECTED(rep_opportunity_overlap),
			        rep_opportunity_overlap[meas.rep_opp_overlap_assigned_opportunities] > 0
			    )
			var credited =
			    SUMX(
			        eligible_reps,
			        rep_opportunity_overlap[meas.rep_opp_overlap_assigned_opportunities]
			    )
			var evidenced =
			    SUMX(
			        eligible_reps,
			        rep_opportunity_overlap[meas.rep_opp_overlap_participated_opportunities]
			    )
			var res = DIVIDE(evidenced, credited, BLANK())
			return res
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: _rep_opportunity_overlap
		lineageTag: 213656cb-fb00-481a-bad6-578b754d61d0

	/// Difference between a representative's participation integrity rate and the selected organization integrity rate.
	measure 'meas.rep_opp_overlap_participation_gap_pp' = ```
			
			var participation_pct = rep_opportunity_overlap[meas.rep_opp_overlap_participation_pct]
			var organization_pct = rep_opportunity_overlap[meas.rep_opp_overlap_overall_avg_participation_pct]
			var res = participation_pct - organization_pct
			return res
			
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: _rep_opportunity_overlap
		lineageTag: 27c3cece-b09a-4a16-8241-907f845a44fb

	/// Includes reps with at least one credited opportunity in the current context.
	measure 'meas.rep_opp_overlap_include_row' = ```
			
			var credited_opportunities = rep_opportunity_overlap[meas.rep_opp_overlap_assigned_opportunities]
			var res = IF(credited_opportunities > 0, 1, 0)
			return res
			
			```
		formatString: 0
		displayFolder: _rep_opportunity_overlap
		lineageTag: 239b1099-cce8-4568-9724-5d94b477fbe0

	/// Review label for credited opportunity participation evidence.
	measure 'meas.rep_opp_overlap_participation_status' = ```
			
			var credited_opportunities = rep_opportunity_overlap[meas.rep_opp_overlap_assigned_opportunities]
			var mismatch_pct = rep_opportunity_overlap[meas.rep_opp_overlap_potential_credit_mismatch_pct]
			var res =
			    SWITCH(
			        TRUE(),
			        ISBLANK(credited_opportunities) || credited_opportunities = 0, "No credited opportunities",
			        mismatch_pct = 0, "Complete recorded participation",
			        mismatch_pct = 1, "No recorded participation in credited opportunities",
			        "Some credited opportunities need review"
			    )
			return res
			
			```
		displayFolder: _rep_opportunity_overlap
		lineageTag: 9a907f85-cc94-4bbd-98e5-36753796e908

	/// Count of Account Executives with at least one credited opportunity lacking governed step-owner activity evidence.
	measure 'meas.rep_opp_overlap_reps_below_threshold' = ```
			
			var reps_with_mismatch =
			    FILTER(
			        VALUES(rep_opportunity_overlap[User Id]),
			        rep_opportunity_overlap[meas.rep_opp_overlap_include_row] = 1
			            && rep_opportunity_overlap[meas.rep_opp_overlap_no_meaningful_participation_opportunities] > 0
			    )
			var res = COUNTROWS(reps_with_mismatch)
			return res
			
			```
		formatString: #,0
		displayFolder: _rep_opportunity_overlap
		lineageTag: 61159841-1f00-490a-9b0d-53af83af368a

	measure 'meas.rep_opp_overlap_lowest_participation_rep' = ```
			
			var eligible_reps =
			    FILTER(
			        ALLSELECTED(rep_opportunity_overlap),
			        rep_opportunity_overlap[meas.rep_opp_overlap_include_row] = 1
			    )
			var bottom_rep =
			    TOPN(
			        1,
			        eligible_reps,
			        rep_opportunity_overlap[meas.rep_opp_overlap_participation_pct],
			        ASC,
			        rep_opportunity_overlap[meas.rep_opp_overlap_assigned_opportunities],
			        DESC,
			        rep_opportunity_overlap[Representative],
			        ASC
			    )
			var res = CONCATENATEX(bottom_rep, rep_opportunity_overlap[Representative])
			return res
			
			```
		displayFolder: _rep_opportunity_overlap
		lineageTag: 4ec4b17b-27ee-43c2-a5df-e7f7df23c048

	measure 'meas.rep_opp_overlap_lowest_participation_detail' = ```
			
			var eligible_reps =
			    FILTER(
			        ALLSELECTED(rep_opportunity_overlap),
			        rep_opportunity_overlap[meas.rep_opp_overlap_include_row] = 1
			    )
			var bottom_rep =
			    TOPN(
			        1,
