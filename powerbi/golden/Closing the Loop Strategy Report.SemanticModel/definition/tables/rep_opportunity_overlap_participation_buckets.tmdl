	partition rep_opportunity_overlap_participation_buckets = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "Bucket", STRING,
				    "Bucket Sort", INTEGER,
				    "Bucket Min", DOUBLE,
				    "Bucket Max", DOUBLE,
				    {
				        {"No rep participation recorded", 1, 0.00, 1.00},
				        {"1 rep involved", 2, 1.00, 2.00},
				        {"2 reps involved", 3, 2.00, 3.00},
				        {"3+ reps involved", 4, 3.00, 999999.00}
				    }
				)
				
				```

