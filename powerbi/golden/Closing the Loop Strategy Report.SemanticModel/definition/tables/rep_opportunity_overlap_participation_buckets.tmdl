table rep_opportunity_overlap_participation_buckets
	lineageTag: faea2312-02bd-4152-b568-5a7dc462a97a

	/// Number of credited opportunities whose recorded activity evidence shows the selected number of involved reps.
	measure 'meas.rep_opp_overlap_bucket_rep_count' = ```
			
			var bucket_min = SELECTEDVALUE(rep_opportunity_overlap_participation_buckets[Bucket Min])
			var bucket_max = SELECTEDVALUE(rep_opportunity_overlap_participation_buckets[Bucket Max])
			var credited_opportunities =
			    CALCULATETABLE(
			        VALUES(opps[_sys_doc_id]),
			        TREATAS(VALUES(rep_opportunity_overlap[User Id]), opps[trueai_owner_id])
			    )
			var opportunity_reps =
			    ADDCOLUMNS(
			        credited_opportunities,
			        "__meaningfully_involved_reps",
			            var current_opp_id = opps[_sys_doc_id]
			            return
			                CALCULATE(
			                    DISTINCTCOUNT(ssr_history[step_owner_id]),
			                    ssr_history[col.sales_steps_opp_id] = current_opp_id,
			                    FILTER(
			                        ssr_history,
			                        ssr_history[step_name] IN {"New Logo Selling", "Existing Customer Selling"}
			                            && (
			                                COALESCE(ssr_history[step_owner_act], 0) > 0
			                                    || COALESCE(ssr_history[step_owner_dur], 0) > 0
			                            )
			                    )
			                )
			    )
			var res =
			    COUNTROWS(
			        FILTER(
			            opportunity_reps,
			            [__meaningfully_involved_reps] >= bucket_min
			                && [__meaningfully_involved_reps] < bucket_max
			        )
			    )
			return res
			
			```
		formatString: #,0
		displayFolder: _rep_opportunity_overlap
		lineageTag: 30b121b1-4803-4cbf-8ae7-73d19fe72cd8

